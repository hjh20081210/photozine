[project]
requires = ["nodejs-24"]

[dev]
build = ["sh", "-c", "cd zine-server && pnpm install && cd ../zine-app && pnpm install && pnpm run build:h5"]
run   = ["sh", "-c", "cd zine-server && PORT=${DEPLOY_RUN_PORT:-5000} node src/server.js"]

[deploy]
build = ["sh", "-c", "cd zine-server && pnpm install && cd ../zine-app && pnpm install && pnpm run build:h5"]
run   = ["sh", "-c", "cd zine-server && PORT=${DEPLOY_RUN_PORT:-5000} node src/server.js"]
