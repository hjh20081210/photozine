[project]
requires = ["nodejs-24"]

[dev]
build = ["sh", "-c", "cd zine-app && pnpm install && pnpm run build:h5"]
run = ["sh", "-c", "cd zine-app/dist/build/h5 && npx serve -l ${DEPLOY_RUN_PORT} -s ."]

[deploy]
build = ["sh", "-c", "cd zine-app && pnpm install && pnpm run build:h5"]
run = ["sh", "-c", "cd zine-app/dist/build/h5 && npx serve -l ${DEPLOY_RUN_PORT} -s ."]
